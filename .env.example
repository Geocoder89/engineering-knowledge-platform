POSTGRES_USER=decision_user
POSTGRES_PASSWORD=decision_password
POSTGRES_DB=decision_workflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://decision_user:decision_password@localhost:5432/decision_workflow

DOCUMENT_STORAGE_PATH=var/document-storage
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_PROCESSING_POLL_INTERVAL_SECONDS=1.0

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Session authentication
SESSION_COOKIE_NAME=decision_session

# Set to true when the application is served over HTTPS in production.
SESSION_COOKIE_SECURE=false

SESSION_COOKIE_SAMESITE=lax

# Resend email-verification delivery
# The following three settings must be configured together.
# RESEND_API_KEY=re_your_api_key
# EMAIL_SENDER_IDENTITY=Knowledge Decision Platform <accounts@your-domain.example>
# EMAIL_VERIFICATION_URL=https://app.example.com/verify-email

EMAIL_DELIVERY_TIMEOUT_SECONDS=10.0
